# Copy to .env.local — never commit .env.local
# See docs/intelligence-engine-setup.md

# --- Client-safe (browser) ---
NEXT_PUBLIC_GA_ID=

# --- Server-only: Intelligence Engine (GA4 OAuth) ---
GA4_PROPERTY_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional — defaults to http://localhost:3000/api/intelligence/google-oauth-callback
# GOOGLE_OAUTH_REDIRECT_URI=

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
INTELLIGENCE_EMAIL_FROM=
INTELLIGENCE_EMAIL_TO=
CRON_SECRET=

# --- Server-only: Executive Dashboard ---
# Production always returns 404 for /executive-dashboard.
# Local/non-production remains available for internal review.
# robots noindex is SEO only — not access control.
# Do not expose this route on the public production domain without genuine
# authentication or confirmed Vercel Deployment Protection.

# --- Server-only: Diamond Intelligence OCR worker (production) ---
# When OCR_WORKER_URL is set, diagram OCR routes to the external worker instead of in-process Tesseract.
# OCR_WORKER_URL=
# OCR_WORKER_SECRET=

# --- Server-only: existing app routes ---
# Concierge HubSpot private-app token (never NEXT_PUBLIC_*).
# Prefer HUBSPOT_ACCESS_TOKEN; HUBSPOT_PRIVATE_APP_TOKEN is an accepted alias.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_DEAL_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_ID_NEW_INQUIRY=
BLOB_READ_WRITE_TOKEN=

# Optional — Concierge rate-limit bypass for local/test only (ignored in production)
# CONCIERGE_RATE_LIMIT_DISABLED=1
