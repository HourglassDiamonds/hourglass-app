# Copy to .env.local — never commit .env.local
# See docs/intelligence-engine-setup.md

# --- Client-safe (browser) ---
# GA4 measurement ID (G-…). Loaded in the browser only when client analytics is enabled.
NEXT_PUBLIC_GA_ID=
# Server-only opt-in for intentional local / Vercel Preview GA validation (DebugView).
# Production (VERCEL_ENV=production) enables client GA automatically when NEXT_PUBLIC_GA_ID is set.
# Preview and local stay OFF unless this is exactly 1 — prevents polluting the production property.
# GA_CLIENT_ENABLED=1

# --- Server-only: Intelligence Engine (GA4 OAuth) ---
GA4_PROPERTY_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional — defaults to http://localhost:3000/api/intelligence/google-oauth-callback
# GOOGLE_OAUTH_REDIRECT_URI=
# Exact Search Console property string (e.g. sc-domain:hourglassdiamonds.com)
# GSC_SITE_URL=

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
INTELLIGENCE_EMAIL_FROM=
INTELLIGENCE_EMAIL_TO=
CRON_SECRET=

# --- Server-only: Agent OS cadence email + durable persistence ---
# Production scheduled-live uses Supabase (SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY)
# and requires lib/supabase/agent-os-schema.sql applied.
# Email resolution order (complete pairs only — no partial mixing):
#   1) AGENT_OS_EMAIL_FROM + AGENT_OS_EMAIL_TO
#   2) INTELLIGENCE_EMAIL_FROM + INTELLIGENCE_EMAIL_TO
#   3) fail closed
# Also requires RESEND_API_KEY. Cron route uses CRON_SECRET (Bearer / x-cron-secret only).
# AGENT_OS_EMAIL_FROM=agent-os@example.com
# AGENT_OS_EMAIL_TO=founder@example.com
# AGENT_OS_RECIPIENT_ALIAS=founder

# --- Server-only: Executive Dashboard auth (never NEXT_PUBLIC_*) ---
# Vercel production (`VERCEL_ENV=production`):
#   - metrics dashboard remains hidden (404)
#   - /executive-dashboard/login and /executive-dashboard/concierge stay session-gated
# Preview + local require a signed session. Cookie path stays /executive-dashboard.
# robots noindex is SEO only — not access control.
#
# EXECUTIVE_DASHBOARD_USERNAME=founder
# EXECUTIVE_DASHBOARD_SESSION_SECRET=   # generate separately: openssl rand -hex 32
# Password hash format: scrypt$<salt_b64url>$<hash_b64url>
# Generate hash (password via stdin only — do not put the password on the command line;
# stdout prints only the scrypt hash; session secret is unrelated and not printed here):
# node -e "const {scryptSync,randomBytes}=require('crypto');let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{const pw=d.trim();if(!pw){console.error('No password on stdin');process.exit(1)}const s=randomBytes(16);const h=scryptSync(pw,s,32,{N:16384,r:8,p:1});console.log('scrypt$'+s.toString('base64url')+'$'+h.toString('base64url'))})"
# EXECUTIVE_DASHBOARD_PASSWORD_HASH=
#
# Optional local/test-only login rate-limit bypass (ignored when NODE_ENV=production
# or VERCEL_ENV=production):
# EXECUTIVE_DASHBOARD_AUTH_RATE_LIMIT_DISABLED=1
# In-memory login limiter is a minor code layer only — enable Vercel WAF / Deployment
# Protection for real abuse defense; do not treat the in-app limiter as sufficient alone.

# --- Server-only: Diamond Intelligence OCR worker (production) ---
# When OCR_WORKER_URL is set, diagram OCR prefers the external worker.
# If the worker health check fails, interpret falls back to in-process bundled Tesseract.
# OCR_WORKER_URL=
# OCR_WORKER_SECRET=

# --- Server-only: existing app routes ---
# Concierge HubSpot private-app token (never NEXT_PUBLIC_*).
# Prefer HUBSPOT_ACCESS_TOKEN; HUBSPOT_PRIVATE_APP_TOKEN is an accepted alias.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_DEAL_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_ID_NEW_INQUIRY=
# Optional Concierge SLA task owner + deal deep links (P0-5). Do not invent values.
# HUBSPOT_OWNER_ID=
# HUBSPOT_PORTAL_ID=
# Private app must include crm.objects.tasks.read + crm.objects.tasks.write for SLA tasks.
#
# P0-5 Concierge Lead SLA — server-only rollout gate (default OFF).
# Set exactly "true" only after Supabase schema + HubSpot task scopes are ready.
# CONCIERGE_SLA_ENABLED=
#
# Preferred Concierge alert recipient pair (revenue-protection alerts).
# CONCIERGE_ALERT_EMAIL_FROM=
# CONCIERGE_ALERT_EMAIL_TO=
# Fallback order when Concierge pair is unset (complete pairs only, never mixed):
#   1) AGENT_OS_EMAIL_FROM + AGENT_OS_EMAIL_TO
#   2) INTELLIGENCE_EMAIL_FROM + INTELLIGENCE_EMAIL_TO
# Always requires RESEND_API_KEY.
#
# --- Server-only: Diamond Studio Email This View (visitor-facing) ---
# Distinct from Agent OS / Concierge founder alerts. Not marketing consent.
# Requires a verified Resend From identity. Preferred:
# STUDIO_VIEW_EMAIL_FROM=Hourglass Diamonds <studio@updates.hourglassdiamonds.com>
# Preview/production will 503 until this verified sender is set.
# Optional local-only origin for development emails (never used in production):
# STUDIO_EMAIL_LOCAL_ORIGIN=http://localhost:3000
# Optional local/test-only rate-limit bypass (ignored in production):
# STUDIO_EMAIL_RATE_LIMIT_DISABLED=1
# Persistence: apply lib/supabase/diamond-studio-identified-events-schema.sql
# when ready. Until then, identified events stay in-memory on the instance.
BLOB_READ_WRITE_TOKEN=

# Optional — Concierge rate-limit bypass for local/test only (ignored in production)
# CONCIERGE_RATE_LIMIT_DISABLED=1
